{
  "name": "jevexpress",
  "version": "0.1.1",
  "description": "Express with no routes. TypeSafe Jev picks which handler runs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "tsx examples/mock-test.ts",
    "demo": "tsx examples/demo.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "express",
    "jev",
    "typesafe",
    "router",
    "middleware",
    "openrouter"
  ],
  "author": "Carl Lippert",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carllippert/jev-router.git"
  },
  "homepage": "https://github.com/carllippert/jev-router#readme",
  "bugs": {
    "url": "https://github.com/carllippert/jev-router/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "express": "^4.21.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
